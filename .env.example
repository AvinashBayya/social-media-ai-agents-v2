# Sentinel AI — environment configuration reference.
#
# Copy to `.env` for local development (`.env`/`.env.*` are gitignored) or
# set these as Azure Container Apps secrets (this deployment uses Key Vault
# `secretref:` env vars reaching the app via its system-assigned identity —
# see CLAUDE.md's "Deployed config" note). No plaintext key belongs in a
# committed file; this file documents NAMES only, every value below is empty.
#
# Nothing here is required for Sentinel to start. Every value left unset
# degrades one specific feature honestly (an explicit "unavailable"/"not
# configured" state) rather than blocking the app or fabricating a result —
# see CLAUDE.md's hard constraints. Most of the social-collection credentials
# below can ALSO be entered on the Settings page instead of as env vars
# (`src/utils/credential-vault.ts`'s operator vault, `./data/credentials.json`,
# gitignored); env vars take precedence when both are set.

# ─── LLM (Module 1/2/5 — summarisation, entities, report generation) ───────
# Open-source models only — see CLAUDE.md "Hard constraints" before changing
# LLM_MODEL/LLM_FALLBACK_MODEL. Fallback is used only on 429/5xx from primary.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# ─── Audio transcription (Module 4, Video Intelligence — src/utils/transcription.ts) ─
# Sarvam speech-to-text (saaras:v3). Reuses LLM_API_KEY above by default — verified
# live that the same Sarvam key works for both chat and speech-to-text — so nothing
# extra is required to enable this once LLM_API_KEY is set. Only set SARVAM_API_KEY
# if you want a separate key/billing line for speech specifically.
SARVAM_API_KEY=
# Sarvam's native speech API lives at a different path than the OpenAI-compatible
# chat endpoint (no /v1), so it is not derived from LLM_BASE_URL. Unset defaults to
# https://api.sarvam.ai.
SARVAM_STT_BASE_URL=

# ─── OSINT job persistence (src/utils/osint/job-store-sqlite.ts) ───────────
# Unset (default): in-memory, lost on restart/scale-to-zero. Set to a file
# path (e.g. ./data/jobs.sqlite) to persist investigations/jobs across cold
# starts. The parent directory is created automatically if missing.
JOB_STORE_PATH=

# ─── OSINT external tool workers (theHarvester/SpiderFoot) ─────────────────
# Unset by default in every environment — no worker is deployed. This is the
# honest current state, not a placeholder to fill blindly; standing up either
# worker is real infrastructure (see docs/OSINT-INTEGRATION-PLAN.md §13-15).
# Until set, both collectors report "unavailable" and every other collector
# still runs normally.
THEHARVESTER_WORKER_URL=
SPIDERFOOT_WORKER_URL=
# Optional SpiderFoot tuning — sensible defaults apply if unset (passive
# use-case, 5s poll interval, 2 minute max wait for a scan to finish).
SPIDERFOOT_USE_CASE=
SPIDERFOOT_POLL_INTERVAL_MS=
SPIDERFOOT_MAX_WAIT_MS=

# ─── Social collection credentials ──────────────────────────────────────────
# Reddit: without this, every unauthenticated endpoint returns 403 and Reddit
# collects nothing at all. reddit.com/prefs/apps -> create app -> type "script".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky: without this, historical keyword search is unavailable (403) and
# collection only runs forward from when the Jetstream socket connects — the
# single largest collection gain any credential here buys.
# bsky.app -> Settings -> Privacy and security -> App Passwords.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Mastodon: without this, only hashtag timelines are reachable (no full-text
# search). <your-instance> -> Preferences -> Development -> New application.
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=

# YouTube: without this, metadata/captions still work (InnerTube), but comment
# collection does not. console.cloud.google.com -> enable YouTube Data API v3.
YOUTUBE_API_KEY=

# Instagram and Facebook have no credential here and never will — Meta's terms
# prohibit the broad scraping this system would need, and no token makes that
# compliant. See CLAUDE.md and credential-vault.ts's "blocked" entries.

# ─── GIS layer credentials (Module 5) ───────────────────────────────────────
# UCDP conflict-event layer: UCDP GED began requiring this 2026-08-04; without
# it the layer reports the missing credential rather than showing zero events.
UCDP_API_TOKEN=

# ReliefWeb humanitarian layer: without it the layer reports the missing
# credential rather than showing zero events, same as UCDP above —
# reliefweb.int/developers, free, no review.
RELIEFWEB_APP_NAME=

# Kpler Supply & Demand layer (grains balance sheets, LNG/gas supply-demand-
# storage balances, by country): Kpler is a COMMERCIAL data provider with no
# free tier — this is a real paid subscription, not a registration form. See
# docs/OpenApiSpec-Supply & Demand-v2.json. Without it the layer reports the
# missing credential rather than showing zero supply/demand, same as above.
KPLER_API_KEY=

# ─── GIS tile provider (Module 5, src/utils/leaflet-client.ts) ─────────────
# Config, never code — mirrors llm.ts's provider-swap discipline. Unset (all
# of these): the map falls back to CARTO_DARK, the one provider actually
# tested in this codebase. Set VITE_GIS_TILE_URL_TEMPLATE to point at any
# other raster tile source (a self-hosted/air-gapped server included) with no
# code change. VITE_ prefix because the tile request is a browser fetch, so
# Vite must inline these at build time.
VITE_GIS_TILE_URL_TEMPLATE=
VITE_GIS_TILE_ID=
VITE_GIS_TILE_HOST=
VITE_GIS_TILE_OPERATOR=
VITE_GIS_TILE_PATH_TEMPLATE=
VITE_GIS_TILE_ATTRIBUTION=
VITE_GIS_TILE_MAX_ZOOM=

# ─── GIS v2 (Module 5 extensions) ──────────────────────────────────────────
# One flag gates the whole GIS-v2 initiative: the GDELT 2.0 Events layer,
# server-side RSS aggregation, and the Timeline component. Unset (default):
# every new layer/panel reports itself disabled rather than appearing empty.
GIS_V2_ENABLED=

# Configurable RSS feed list for aggregation (src/utils/news-aggregation.ts).
# Unset: uses the verified default seed list (BBC World, Al Jazeera, PIB
# India, Defense One, USNI News, Breaking Defense — Reuters/AP/MEA have no
# working public feed as of 2026-08, so are not included). Set to a JSON
# array of {id, name, url[, enabled]} to override entirely.
NEWS_RSS_FEEDS=

# Optional OpenSky Network flight-track layer ("assets/tracks"). Off by
# default, gated SEPARATELY from GIS_V2_ENABLED since it is networked-only
# and explicitly optional. No API key needed for a bounded-area query.
OPENSKY_TRACKS_ENABLED=
# Bounding box for the query — unset defaults to a South Asia box
# (lamin=6, lomin=68, lamax=37, lomax=98). The full-globe query returns tens
# of thousands of aircraft and is not requested by default.
OPENSKY_BBOX_LAMIN=
OPENSKY_BBOX_LOMIN=
OPENSKY_BBOX_LAMAX=
OPENSKY_BBOX_LOMAX=

# ─── OSINT (Module 2) ────────────────────────────────────────────────────────
# Raises GitHub search from 10 req/min to 30, and the core API from 60/hour to
# 5,000. github.com/settings/tokens -> generate new token -> no scopes needed.
GITHUB_TOKEN=

# ─── ai-service (Module 4 local models — see ai-service/CLAUDE.md section) ──
# Separate FastAPI backend, own host, own .venv — not started by `bun dev`.
# Run it yourself (uvicorn app.main:app --reload) before using detection,
# description or face analysis on /images; those panels report the service
# unavailable rather than falling back to a fabricated result. VITE_ prefix
# because this is read in the browser, which calls ai-service directly.
# Unset defaults to http://localhost:8000, ai-service's own default port.
VITE_AI_SERVICE_URL=
