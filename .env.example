# Sentinel AI — environment configuration reference.
#
# Copy to `.env` for local development (`.env`/`.env.*` are gitignored).
#
# There is no hosted deployment: Azure, and with it the Key Vault that used to
# hold these, was removed 2026-08-20. Keys now live in a local `.env` or the
# operator vault on /settings (`data/credentials.json`, gitignored). That is a
# real reduction in key hygiene — treat these as demo credentials.
#
# No plaintext key belongs in a committed file; this documents NAMES only, and
# every value below is empty.
#
# Nothing here is required for Sentinel to start. Every value left unset
# degrades one specific feature honestly (an explicit "unavailable"/"not
# configured" state) rather than blocking the app or fabricating a result —
# see CLAUDE.md's hard constraints. Most of the social-collection credentials
# below can ALSO be entered on the Settings page instead of as env vars
# (`src/utils/credential-vault.ts`'s operator vault, `./data/credentials.json`,
# gitignored); env vars take precedence when both are set.

# ─── LLM (Module 1/2/5 — summarisation, entities, report generation) ───────
# Open-source models only — see CLAUDE.md "Hard constraints" before changing
# LLM_MODEL/LLM_FALLBACK_MODEL. Fallback is used only on 429/5xx from primary.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# ─── OSINT job persistence (src/utils/osint/job-store-sqlite.ts) ───────────
# Unset (default): in-memory, lost on restart/scale-to-zero. Set to a file
# path (e.g. ./data/jobs.sqlite) to persist investigations/jobs across cold
# starts. The parent directory is created automatically if missing.
JOB_STORE_PATH=

# ─── OSINT external tool workers (theHarvester/SpiderFoot) ─────────────────
# Unset by default in every environment — no worker is deployed. This is the
# honest current state, not a placeholder to fill blindly; standing up either
# worker is real infrastructure (see docs/OSINT-INTEGRATION-PLAN.md §13-15).
# Until set, both collectors report "unavailable" and every other collector
# still runs normally.
THEHARVESTER_WORKER_URL=
SPIDERFOOT_WORKER_URL=
# Optional SpiderFoot tuning — sensible defaults apply if unset (passive
# use-case, 5s poll interval, 2 minute max wait for a scan to finish).
SPIDERFOOT_USE_CASE=
SPIDERFOOT_POLL_INTERVAL_MS=
SPIDERFOOT_MAX_WAIT_MS=

# ─── Self-hosted OSINT stack (osint-workers/docker-compose.yml) ─────────────
# Runs locally under docker compose. Start the stack with:
#   docker compose -f osint-workers/docker-compose.yml up -d

# SearXNG — self-hosted metasearch. Makes the 13 web-scoped Google dorks in
# dorks.ts executable. Free, keyless, no vendor quota. NOTE: the JSON format is
# OFF in a stock install and `format=json` answers HTTP 403 until settings.yml
# lists `json` under search.formats — osint-workers/searxng/settings.yml does.
# This replaces Google Custom Search, which is closed to new customers and is
# discontinued 2027-01-01. Unset: web dorks stay analyst-run query strings.
SEARXNG_URL=

# IVRE — self-hosted network scan storage, the free alternative to Shodan's
# paid search API (which cannot be self-hosted: the product IS their dataset).
# Unset: the collector reports unavailable and nothing is scanned.
IVRE_URL=

# ─── Social collection credentials ──────────────────────────────────────────
# Reddit: without this, every unauthenticated endpoint returns 403 and Reddit
# collects nothing at all. reddit.com/prefs/apps -> create app -> type "script".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky: without this, historical keyword search is unavailable (403) and
# collection only runs forward from when the Jetstream socket connects — the
# single largest collection gain any credential here buys.
# bsky.app -> Settings -> Privacy and security -> App Passwords.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Mastodon: without this, only hashtag timelines are reachable (no full-text
# search). <your-instance> -> Preferences -> Development -> New application.
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=

# YouTube: without this, metadata/captions still work (InnerTube), but comment
# collection does not. console.cloud.google.com -> enable YouTube Data API v3.
YOUTUBE_API_KEY=

# Instagram and Facebook have no credential here and never will — Meta's terms
# prohibit the broad scraping this system would need, and no token makes that
# compliant. See CLAUDE.md and credential-vault.ts's "blocked" entries.

# ─── GIS layer credentials (Module 5) ───────────────────────────────────────
# UCDP conflict-event layer: UCDP GED began requiring this 2026-08-04; without
# it the layer reports the missing credential rather than showing zero events.
UCDP_API_TOKEN=

# ReliefWeb humanitarian layer: not wired into a live layer yet (see
# CLAUDE.md's Module 5 section) — reliefweb.int/developers, free, no review.
RELIEFWEB_APP_NAME=

# ─── OSINT (Module 2) ────────────────────────────────────────────────────────
# Raises GitHub search from 10 req/min to 30, and the core API from 60/hour to
# 5,000. github.com/settings/tokens -> generate new token -> no scopes needed.
GITHUB_TOKEN=

# ─── Inbound rate limiting (src/utils/rate-limit.ts + rate-limit-runtime.ts) ─
# Applies to Sentinel's OWN server functions. Nothing to do with the per-source
# upstream limits above (GDELT 1 req/5s, Reddit 100/min, and so on) — those are
# handled inside each collector.
#
# observe (DEFAULT when unset) — logs what it WOULD have denied, denies nothing.
# enforce — actually denies, with exponential backoff.
# off     — skips the check entirely.
#
# Deploy in observe first. Read the log lines it emits and confirm the client
# key source says "forwarded"; if it says "unknown", the ingress is not passing
# x-forwarded-for or the hop count below is wrong, and enforcing in that state
# collapses every caller into one bucket.
RATE_LIMIT_MODE=

# Proxies in front of this process. Azure Container Apps' Envoy ingress is 1.
# The trusted entry is counted from the RIGHT — see src/utils/client-ip.ts for
# why the leftmost entry must never be used. Default 1.
RATE_LIMIT_TRUSTED_PROXY_HOPS=

# Prefix IPv6 addresses collapse to, so one /64 allocation cannot mint a fresh
# identity per request. Default 64.
RATE_LIMIT_IPV6_PREFIX_BITS=

# Purely a warning knob. Counters live in process memory, so N replicas permit
# N times every limit below. Set it to the real replica count and the limiter
# says so loudly at boot rather than silently over-permitting. Default 1.
RATE_LIMIT_EXPECTED_REPLICAS=

# Bounds on the counter map. Defaults: 10000 keys, sweep every 512 checks or
# 60000ms, whichever comes first.
RATE_LIMIT_MAX_KEYS=
RATE_LIMIT_SWEEP_EVERY=
RATE_LIMIT_SWEEP_MS=

# Per-tier overrides. Six tiers: STRICT (credential vault, 5/min),
# EXPENSIVE (LLM, reports, YouTube download, 10/min), MODERATE (collectors and
# every unclassified function, 30/min), LOOSE (local reads, 120/min),
# GLOBAL (per-IP ceiling, 240/min), UNKNOWNIP (unattributable callers, 60/min).
# Each accepts five suffixes; all optional, all fall back per-field:
#   RATE_LIMIT_<TIER>_LIMIT
#   RATE_LIMIT_<TIER>_WINDOW_MS
#   RATE_LIMIT_<TIER>_BASE_BACKOFF_MS
#   RATE_LIMIT_<TIER>_MAX_BACKOFF_MS
#   RATE_LIMIT_<TIER>_STRIKE_DECAY_WINDOWS
# A malformed value falls back to the default AND warns naming the variable —
# the limit is never silently disabled by a typo.
RATE_LIMIT_STRICT_LIMIT=
RATE_LIMIT_EXPENSIVE_LIMIT=
RATE_LIMIT_MODERATE_LIMIT=
RATE_LIMIT_LOOSE_LIMIT=
RATE_LIMIT_GLOBAL_LIMIT=
RATE_LIMIT_UNKNOWNIP_LIMIT=

# ─── ACTIVE SCAN AUTHORISATIONS (src/utils/scan-authorization.ts) ───────────
# ⚠️ READ BEFORE SETTING. Every other collector in this system is PASSIVE: it
# reads a third-party record ABOUT a target and never sends the target a
# packet. IVRE/Nmap data comes from packets on the wire, which is lawful only
# with the owner's permission. This variable is the ONLY thing that permits it.
#
# A JSON array. UNSET OR MALFORMED MEANS NO TARGET IS AUTHORISED — a bad value
# is treated as empty, never as permissive. There is no override flag.
#
# Every field is required. `expiresAt` especially: an authorisation with no end
# is not an authorisation, it is a standing permission nobody revisits.
# `authorisedBy` must name a PERSON, not a role — a role cannot be asked what
# it approved.
#
# Private, loopback, link-local and reserved ranges are refused even when
# covered, unless the caller explicitly opts in (lab ranges you own).
#
# SCAN_AUTHORISATIONS=[{"target":"example.com","scope":"active","authorisedBy":"Wg Cdr A. Sharma","reference":"IAF/PS18/AUTH/2026/014","grantedAt":"2026-08-01T00:00:00Z","expiresAt":"2026-09-01T00:00:00Z"}]
SCAN_AUTHORISATIONS=
