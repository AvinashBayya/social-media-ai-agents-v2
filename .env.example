# Sentinel AI — environment configuration reference.
#
# Copy to `.env` for local development (`.env`/`.env.*` are gitignored) or
# set these as Azure Container Apps secrets (this deployment uses Key Vault
# `secretref:` env vars reaching the app via its system-assigned identity —
# see CLAUDE.md's "Deployed config" note). No plaintext key belongs in a
# committed file; this file documents NAMES only, every value below is empty.
#
# Nothing here is required for Sentinel to start. Every value left unset
# degrades one specific feature honestly (an explicit "unavailable"/"not
# configured" state) rather than blocking the app or fabricating a result —
# see CLAUDE.md's hard constraints. Most of the social-collection credentials
# below can ALSO be entered on the Settings page instead of as env vars
# (`src/utils/credential-vault.ts`'s operator vault, `./data/credentials.json`,
# gitignored); env vars take precedence when both are set.

# ─── LLM (Module 1/2/5 — summarisation, entities, report generation) ───────
# Open-source models only — see CLAUDE.md "Hard constraints" before changing
# LLM_MODEL/LLM_FALLBACK_MODEL. Fallback is used only on 429/5xx from primary.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# ─── OSINT job persistence (src/utils/osint/job-store-sqlite.ts) ───────────
# Unset (default): in-memory, lost on restart/scale-to-zero. Set to a file
# path (e.g. ./data/jobs.sqlite) to persist investigations/jobs across cold
# starts. The parent directory is created automatically if missing.
JOB_STORE_PATH=

# ─── OSINT external tool workers (theHarvester/SpiderFoot) ─────────────────
# Unset by default in every environment — no worker is deployed. This is the
# honest current state, not a placeholder to fill blindly; standing up either
# worker is real infrastructure (see docs/OSINT-INTEGRATION-PLAN.md §13-15).
# Until set, both collectors report "unavailable" and every other collector
# still runs normally.
THEHARVESTER_WORKER_URL=
SPIDERFOOT_WORKER_URL=
# Optional SpiderFoot tuning — sensible defaults apply if unset (passive
# use-case, 5s poll interval, 2 minute max wait for a scan to finish).
SPIDERFOOT_USE_CASE=
SPIDERFOOT_POLL_INTERVAL_MS=
SPIDERFOOT_MAX_WAIT_MS=

# ─── Social collection credentials ──────────────────────────────────────────
# Reddit: without this, every unauthenticated endpoint returns 403 and Reddit
# collects nothing at all. reddit.com/prefs/apps -> create app -> type "script".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Bluesky: without this, historical keyword search is unavailable (403) and
# collection only runs forward from when the Jetstream socket connects — the
# single largest collection gain any credential here buys.
# bsky.app -> Settings -> Privacy and security -> App Passwords.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Mastodon: without this, only hashtag timelines are reachable (no full-text
# search). <your-instance> -> Preferences -> Development -> New application.
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=

# YouTube: without this, metadata/captions still work (InnerTube), but comment
# collection does not. console.cloud.google.com -> enable YouTube Data API v3.
YOUTUBE_API_KEY=

# Instagram and Facebook have no credential here and never will — Meta's terms
# prohibit the broad scraping this system would need, and no token makes that
# compliant. See CLAUDE.md and credential-vault.ts's "blocked" entries.

# ─── GIS layer credentials (Module 5) ───────────────────────────────────────
# UCDP conflict-event layer: UCDP GED began requiring this 2026-08-04; without
# it the layer reports the missing credential rather than showing zero events.
UCDP_API_TOKEN=

# ReliefWeb humanitarian layer: not wired into a live layer yet (see
# CLAUDE.md's Module 5 section) — reliefweb.int/developers, free, no review.
RELIEFWEB_APP_NAME=

# ─── OSINT (Module 2) ────────────────────────────────────────────────────────
# Raises GitHub search from 10 req/min to 30, and the core API from 60/hour to
# 5,000. github.com/settings/tokens -> generate new token -> no scopes needed.
GITHUB_TOKEN=
