# Sentinel AI — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# In the Azure deployment these arrive as `secretref:` env vars sourced from
# Key Vault via the container app's system-assigned identity.

# ─── Open-source LLM (see CLAUDE.md — no hosted commercial APIs) ───────────
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_API_KEY=
LLM_MODEL=sarvam-105b

# Used only on 429 / 5xx. A 401/403 does not fail over.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# ─── Optional data sources ────────────────────────────────────────────────
# Without this the UCDP conflict layer reports the missing credential rather
# than rendering as empty.
UCDP_API_TOKEN=
WORLDMONITOR_API_KEY=

# ─── Authentication (required) ─────────────────────────────────────────────
# SQLite file backing users, sessions and the audit log, relative to the
# process working directory. Must live on a persisted volume.
DATABASE_URL=file:./data/sentinel.db

# Seals the session cookie (AES-256). MUST be at least 32 characters.
# Rotating it invalidates every live session — the intended global logout.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session lifetime in seconds. 28800 = 8 hours.
SESSION_MAX_AGE=28800

# Argon2id cost parameters (OWASP baseline).
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Login throttling: 5 failures per identifier/IP in 15 min locks for 15 min.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Seed account for `bun run db:seed`. The seed refuses the default password
# when NODE_ENV=production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@sentinel.local
SEED_ADMIN_PASSWORD=Admin@123
