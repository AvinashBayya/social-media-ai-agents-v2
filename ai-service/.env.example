DEVICE=auto
MODELS_DIR=./models
LOG_LEVEL=INFO
DETECT_BOX_THRESHOLD=0.35
DETECT_TEXT_THRESHOLD=0.25
FACE_MATCH_THRESHOLD=0.5
# Only needed if the system Tesseract install doesn't already carry the
# languages OCR needs (eng/hin/tam) — e.g. a winget install under Program
# Files that isn't writable without admin rights. Points pytesseract's
# underlying tesseract.exe at a user-writable tessdata directory instead.
# Leave unset to use the system Tesseract's own bundled tessdata.
TESSDATA_PREFIX=
