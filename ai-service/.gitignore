.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
*.log

# Vendored model weights (e.g. models/grounding-dino-tiny/, ~650MB) are fetched
# once locally via a download script, never committed. Only the directory
# structure (.gitkeep) is tracked — see PLAN.md/TASKS.md for the air-gap
# packaging procedure that moves real weights onto the target machine.
models/*/
!models/.gitkeep
