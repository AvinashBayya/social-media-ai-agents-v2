.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
*.log

# Vendored model weights (e.g. models/grounding-dino-tiny/, ~650MB) are fetched
# once locally via a download script, never committed. Only the directory
# structure (.gitkeep) is tracked — see PLAN.md/TASKS.md for the air-gap
# packaging procedure that moves real weights onto the target machine.
models/*/
!models/.gitkeep

# Tesseract language data (eng/hin/tam/osd, several MB each) — fetched once
# locally, same reasoning as models/*/ above. Only needed when the system
# Tesseract install doesn't already carry these languages (see TESSDATA_PREFIX
# in .env.example) and system Tesseract itself isn't writable without admin
# rights (e.g. a winget install under Program Files).
tessdata/
