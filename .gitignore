# Scraped social cache. Contains mentions of real, identifiable private
# individuals, so it must never enter a public repo (DPDP Act 2023).
data/social_cache.json

# Auth database. Holds password hashes, live session tokens and the audit
# trail — never commit it. The schema and migrations under prisma/ ARE
# tracked; run `bun run db:migrate` to rebuild the file from them.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Prisma client generated by `bun run db:generate` from prisma/schema.prisma.
src/generated/
